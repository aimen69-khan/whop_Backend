NODE_ENV=development
PORT=4000

# Comma-separated list of allowed frontend origins.
# Do NOT include a trailing slash — browsers send bare origins (e.g. https://example.vercel.app).
CORS_ORIGINS=https://whop-frontend-tau.vercel.app

ADMIN_API_KEY=change-this-to-a-long-random-value

DATA_FILE=./data/leads.json

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
